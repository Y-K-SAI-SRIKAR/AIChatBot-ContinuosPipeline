# ==============================================================================
# AI ChatBot Continuous Learning Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit real credentials, keys, or passwords to Git.

# Google Gemini API Key for Google ADK Agent
GEMINI_API_KEY="your-gemini-api-key-here"

# Runtime Service Configuration
PORT=6655
HOST="0.0.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Active Configuration Resolution Overrides
# Leave empty to use default active configurations in config.yaml
ACTIVE_PROMPT_VERSION="v1.0.0"
ACTIVE_MODEL_VERSION="v0.1.0-baseline"

# MLflow & DagsHub Experiment Tracking
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_TRACKING_USERNAME="your-dagshub-username"
MLFLOW_TRACKING_PASSWORD="your-dagshub-token-or-password"
DAGSHUB_REPO_OWNER="your-username"
DAGSHUB_REPO_NAME="AIChatBot-ContinuosPipeline"

# DVC Remote Storage
DVC_REMOTE_NAME="dagshub_remote"
DVC_REMOTE_URL="s3://dvc"

# Observability
PROMETHEUS_PORT=8000

